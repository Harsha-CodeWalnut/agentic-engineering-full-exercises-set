{
  "name": "notification-mesh-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "npm run test:routing",
    "test:routing": "node ./scripts/run-routing-tests.mjs",
    "graph:build": "node ./scripts/build-code-graph.mjs",
    "graph:build:check": "node ./scripts/verify-code-graph-build.mjs",
    "graph:query": "node ./scripts/query-code-graph.mjs",
    "graph:path": "node ./scripts/find-graph-path.mjs",
    "test:submission": "npm run verify:submission",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run test:routing",
    "verify:submission": "node ./scripts/verify-graph-submission.mjs",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "evidence:seal": "node ./scripts/verify-graph-submission.mjs seal",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs",
    "evidence:verify": "npm run agent:check && npm run verify:implementation && node ./scripts/verify-graph-submission.mjs content"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.0.1",
    "mermaid": "^11.16.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
