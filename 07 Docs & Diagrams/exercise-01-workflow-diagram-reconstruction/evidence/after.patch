diff --git a/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-approval-sequence.mmd b/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-approval-sequence.mmd
new file mode 100644
index 0000000..19e2625
--- /dev/null
+++ b/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-approval-sequence.mmd	
@@ -0,0 +1,28 @@
+sequenceDiagram
+  actor Employee
+  participant Application
+  participant Manager
+  participant PolicyEngine
+  participant Security
+  participant DataOwner
+  participant IdentityProvider
+  %% EDGE: WF-01
+  Employee->>Application: Submit access request from draft
+  %% EDGE: WF-02
+  Application->>Manager: Request manager approval
+  Manager-->>Application: Manager approved the business need
+  alt High risk
+    %% EDGE: WF-03
+    PolicyEngine->>Security: Route high risk request to security review
+    %% EDGE: WF-05
+    Security-->>Application: Security approved high-risk access
+    Application->>DataOwner: Open data owner review after security
+  else Normal risk
+    %% EDGE: WF-04
+    Application->>DataOwner: Open normal data owner review
+  end
+  %% EDGE: WF-06
+  DataOwner-->>Application: Approve data owner access
+  Application->>IdentityProvider: Provision access in identity groups
+  %% EDGE: WF-07
+  IdentityProvider-->>Application: Access granted and provisioned when healthy
diff --git a/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-failure-sequence.mmd b/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-failure-sequence.mmd
new file mode 100644
index 0000000..f1641a3
--- /dev/null
+++ b/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-failure-sequence.mmd	
@@ -0,0 +1,15 @@
+sequenceDiagram
+  participant Application
+  participant DataOwner
+  participant IdentityProvider
+  participant IdentityAdmin
+  %% EDGE: WF-06
+  DataOwner->>Application: Approve data access
+  Application->>IdentityProvider: Provision access
+  %% EDGE: WF-08
+  IdentityProvider-->>Application: Provisioning failed after partial access
+  %% EDGE: WF-09
+  Application->>IdentityProvider: Open rollback request for the unhealthy grant
+  IdentityProvider->>IdentityAdmin: Remove partial access from the identity group
+  %% EDGE: WF-10
+  IdentityAdmin-->>Application: Partial access removed and rolled back
diff --git a/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-state.mmd b/07 Docs & Diagrams/exercise-01-workflow-diagram-reconstruction/diagrams/access-state.mmd
