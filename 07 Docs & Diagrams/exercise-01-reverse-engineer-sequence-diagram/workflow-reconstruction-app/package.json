{
  "name": "workflow-reconstruction-app",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node ../../../scripts/run-vite-build.mjs --skip-typecheck",
    "preview": "node ./node_modules/vite/bin/vite.js preview",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "npm run workflow:trace",
    "lint": "node ./scripts/starter-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "workflow:trace": "node ./scripts/trace-workflow.mjs",
    "test:submission": "npm run verify:submission",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run workflow:trace",
    "verify:submission": "node ./scripts/verify-diagrams.mjs",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "evidence:seal": "node ./scripts/verify-diagrams.mjs seal",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs",
    "evidence:verify": "npm run agent:check && npm run verify:implementation && node ./scripts/verify-diagrams.mjs content",
    "diagrams:parse": "node ./scripts/parse-diagrams.mjs",
    "diagrams:verify": "npm run verify:submission"
  },
  "dependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.0.1",
    "mermaid": "^11.16.1",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
