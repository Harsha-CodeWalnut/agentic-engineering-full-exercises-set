new file mode 100644
index 0000000..3e41ca1
--- /dev/null
+++ b/07 Docs & Diagrams/exercise-03-feature-visualization/diagrams/payment-sequence.mmd	
@@ -0,0 +1,22 @@
+sequenceDiagram
+actor Shopper
+participant CheckoutUI
+participant GatewayAdapter
+participant Ledger
+participant ReceiptNotifier
+participant WebhookHandler
+Shopper->>CheckoutUI: Confirm checkout
+CheckoutUI->>GatewayAdapter: Call external gateway directly
+alt Authorization approved
+  GatewayAdapter-->>CheckoutUI: Authorization approved
+  GatewayAdapter->>Ledger: Create capture ledger entry
+  GatewayAdapter->>ReceiptNotifier: Send receipt
+else Authorization declined
+  GatewayAdapter-->>CheckoutUI: Authorization declined
+  CheckoutUI->>GatewayAdapter: Retry authorization once
+  GatewayAdapter-->>CheckoutUI: Authorization approved after retry
+  GatewayAdapter->>Ledger: Create capture ledger entry
+end
+GatewayAdapter->>WebhookHandler: Deliver signed capture webhook
+WebhookHandler->>Ledger: Create a new ledger entry for every valid capture delivery
+WebhookHandler->>Ledger: Duplicate signed delivery creates another ledger entry
