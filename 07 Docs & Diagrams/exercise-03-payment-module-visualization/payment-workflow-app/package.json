{
  "name": "docs-diagrams-feature-visualization",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1",
    "build": "node ../../../scripts/run-vite-build.mjs",
    "preview": "node ./node_modules/vite/bin/vite.js preview --host 127.0.0.1",
    "typecheck": "node ./node_modules/typescript/bin/tsc --noEmit --pretty false --incremental false",
    "test": "npm run test:feature",
    "test:payments": "node --import tsx ./scripts/run-payment-tests.ts",
    "test:webhooks": "node ./scripts/run-webhook-tests.mjs",
    "test:feature": "npm run test:payments && npm run test:webhooks",
    "payment:trace": "node --import tsx ./scripts/trace-payment.ts",
    "test:submission": "npm run verify:submission",
    "lint": "node ./scripts/lint-check.mjs",
    "format": "node ./scripts/format-check.mjs",
    "agent:check": "npm run test:integrity && npm run lint && npm run test && npm run format && npm run typecheck && npm run build",
    "test:integrity": "node ../../../scripts/verify-protected-inputs.mjs ./challenge-integrity.json",
    "verify:implementation": "npm run test:feature",
    "verify:submission": "node ./scripts/verify-visualization.mjs",
    "verify:exercise:core": "npm run agent:check && npm run verify:implementation && npm run verify:submission",
    "verify:exercise": "node ../../../scripts/run-clean-verification.mjs",
    "evidence:seal": "node ./scripts/verify-visualization.mjs seal",
    "evidence:capture": "node ../../../scripts/capture-verification.mjs",
    "evidence:verify": "npm run agent:check && npm run verify:implementation && node ./scripts/verify-visualization.mjs content",
    "diagrams:parse": "node ./scripts/parse-diagrams.mjs",
    "diagrams:verify": "npm run verify:submission"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@types/react": "^19.2.7",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.4",
    "jsdom": "^29.0.1",
    "mermaid": "^11.16.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
