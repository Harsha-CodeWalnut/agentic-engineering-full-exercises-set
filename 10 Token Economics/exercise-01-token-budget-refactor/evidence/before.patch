diff --git a/10 Token Economics/exercise-01-token-budget-refactor/token-budget-app/tests/session-adapter.test.mjs b/10 Token Economics/exercise-01-token-budget-refactor/token-budget-app/tests/session-adapter.test.mjs
new file mode 100644
index 0000000000000000000000000000000000000000..5a02afc99d57ac22e9de77b65d7f5090aecfbd25
--- /dev/null
+++ b/10 Token Economics/exercise-01-token-budget-refactor/token-budget-app/tests/session-adapter.test.mjs	
@@ -0,0 +1,107 @@
+import assert from "node:assert/strict";
+import test from "node:test";
+
+import { adaptSession, SessionAdapterError } from "../src/session/adaptSession.mjs";
+
+function assertSessionError(input, code, message) {
+  assert.throws(
+    () => adaptSession(input),
+    (error) =>
+      error instanceof SessionAdapterError &&
+      error.name === "SessionAdapterError" &&
+      error.code === code &&
+      error.message === message,
+  );
+}
+
+test("returns only public fields and preserves serialized session values", () => {
+  const result = adaptSession({
+    userId: " user-17 ",
+    roles: ["reviewer", "agent", "reviewer"],
+    expiresAt: "2026-08-14T10:30:00.000Z",
+    ignored: "value",
+  });
+
+  assert.deepEqual(result, {
+    userId: " user-17 ",
+    roles: ["reviewer", "agent"],
+    expiresAt: "2026-08-14T10:30:00.000Z",
+  });
+  assert.equal(result instanceof Promise, false);
+});
+
+test("accepts an empty roles array and an ISO timestamp without milliseconds", () => {
+  assert.deepEqual(
+    adaptSession({
+      userId: "user-18",
+      roles: [],
+      expiresAt: "2026-08-14T10:30:00Z",
+    }),
+    {
+      userId: "user-18",
+      roles: [],
+      expiresAt: "2026-08-14T10:30:00Z",
+    },
+  );
+});
+
+test("rejects a missing or blank userId with the public identity error", () => {
+  const expectedCode = "SESSION_USER_REQUIRED";
+  const expectedMessage = "Session userId is required";
+
+  assertSessionError(
+    { roles: [], expiresAt: "2026-08-14T10:30:00Z" },
+    expectedCode,
+    expectedMessage,
+  );
+  assertSessionError(
+    { userId: "   ", roles: [], expiresAt: "2026-08-14T10:30:00Z" },
+    expectedCode,
+    expectedMessage,
+  );
+});
+
+test("rejects malformed and impossible expiry timestamps with the public expiry error", () => {
+  const expectedCode = "SESSION_EXPIRY_INVALID";
+  const expectedMessage = "Session expiresAt must be an ISO timestamp";
+
+  assertSessionError(
+    { userId: "user-19", roles: [], expiresAt: "tomorrow" },
+    expectedCode,
+    expectedMessage,
+  );
+  assertSessionError(
+    { userId: "user-19", roles: [], expiresAt: "2026-02-30T10:30:00Z" },
+    expectedCode,
+    expectedMessage,
+  );
+});
+
+test("rejects non-array roles and empty role strings with the public roles error", () => {
+  const expectedCode = "SESSION_ROLES_INVALID";
+  const expectedMessage = "Session roles must be an array of non-empty strings";
+
+  assertSessionError(
+    { userId: "user-20", roles: "admin", expiresAt: "2026-08-14T10:30:00Z" },
+    expectedCode,
+    expectedMessage,
+  );
+  assertSessionError(
+    { userId: "user-20", roles: ["admin", "   "], expiresAt: "2026-08-14T10:30:00Z" },
+    expectedCode,
+    expectedMessage,
+  );
+});
+
+test("validates identity, then expiry, then roles", () => {
+  assertSessionError(
+    { roles: "admin", expiresAt: "bad" },
+    "SESSION_USER_REQUIRED",
+    "Session userId is required",
+  );
+  assertSessionError(
+    { userId: "user-21", roles: "admin", expiresAt: "bad" },
+    "SESSION_EXPIRY_INVALID",
+    "Session expiresAt must be an ISO timestamp",
+  );
+});
