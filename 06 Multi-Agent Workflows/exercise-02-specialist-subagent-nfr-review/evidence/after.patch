diff --git a/06 Multi-Agent Workflows/exercise-02-specialist-subagent-nfr-review/nfr-swarm-app/tests/approval-boundary.test.ts b/06 Multi-Agent Workflows/exercise-02-specialist-subagent-nfr-review/nfr-swarm-app/tests/approval-boundary.test.ts
